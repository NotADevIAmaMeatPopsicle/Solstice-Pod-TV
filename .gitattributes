* text=auto

# Enforce LF on Linux/Android build scripts, init rc, patches, kernel sources, and CI
*.sh     text eol=lf
*.rc     text eol=lf
*.patch  text eol=lf
*.py     text eol=lf
*.dts    text eol=lf
*.dtsi   text eol=lf
*.c      text eol=lf
*.h      text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf

# Windows PowerShell scripts
*.ps1    text eol=crlf
