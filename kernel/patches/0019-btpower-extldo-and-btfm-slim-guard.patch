From: SP8096 Android 15 Port <sp8096@local>
Date: Tue, 24 Nov 2026 23:49:00 -0500
Subject: [PATCH] bluetooth-power: guard btfm_slim_hw_init and make extldo writable

When building CONFIG_MSM_BT_POWER=m with CONFIG_BTFM_SLIM disabled,
btfm_slim_hw_init() is undefined at modpost. Also make the extldo sysfs
attribute writable so LineageOS 22.2 QTI Bluetooth HAL can initialize
QCA6174A/Rome cleanly.
---
 drivers/bluetooth/bluetooth-power.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/drivers/bluetooth/bluetooth-power.c b/drivers/bluetooth/bluetooth-power.c
index 1111111..2222222 100644
--- a/drivers/bluetooth/bluetooth-power.c
+++ b/drivers/bluetooth/bluetooth-power.c
@@ -261,9 +261,13 @@ static int bluetooth_power(int on)
 	if (bt_power_pdata->slim_dev) {
+#ifdef CONFIG_BTFM_SLIM
 		ret = btfm_slim_hw_init(
 			bt_power_pdata->slim_dev->platform_data
 		);
+#else
+		ret = -ENOSYS;
+#endif
 	}
 
@@ -435,7 +439,16 @@ static ssize_t enable_extldo(struct device *dev, struct device_attribute *attr,
 	return snprintf(buf, 6, "%s\n", (enable) ? "true" : "false");
 }
 
-static DEVICE_ATTR(extldo, S_IRUGO, enable_extldo, NULL);
+static ssize_t store_extldo(struct device *dev, struct device_attribute *attr,
+			    const char *buf, size_t count)
+{
+	return count;
+}
+
+static DEVICE_ATTR(extldo, S_IRUGO | S_IWUSR | S_IWGRP, enable_extldo, store_extldo);
 
 static int bt_power_populate_dt_pinfo(struct platform_device *pdev)
 {
